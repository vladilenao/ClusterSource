{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cluster-source.local/schemas/config.schema.json",
  "title": "ClusterSource config.yaml",
  "description": "Схема файла config.yaml / config.local.yaml, разбираемого AppConfig.from_yaml(). Неизвестные ключи игнорируются кодом. Код не выполняет валидацию по этой схеме.",
  "type": "object",
  "properties": {
    "TOKEN": {
      "type": "string",
      "description": "Токен T-Investments API. Имеет приоритет над 'token'. Значение 'your-token-here' считается заглушкой.",
      "default": ""
    },
    "token": {
      "type": "string",
      "description": "Альтернативное имя ключа TOKEN; используется, только если TOKEN отсутствует."
    },
    "data_dir": {
      "type": "string",
      "description": "Корневой каталог данных. Хранилище — {data_dir}/history. Относительный путь — от рабочего каталога процесса.",
      "default": "data"
    },
    "batch": {
      "type": "object",
      "description": "Параметры консьюмера DataCollector.",
      "properties": {
        "flush_interval_sec": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 5.0,
          "description": "Период пакетной записи, секунды: тики попадают в SQLite не реже раза за интервал."
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1,
          "default": 1000,
          "description": "Размер буфера, при котором запись выполняется немедленно."
        }
      }
    },
    "archiver": {
      "type": "object",
      "description": "Время ежесуточного обслуживания хранилища (догрузка + архивация), UTC.",
      "properties": {
        "run_hour_utc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23,
          "default": 0
        },
        "run_minute_utc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59,
          "default": 5
        }
      }
    },
    "iss": {
      "type": "object",
      "description": "Сбор ленты Мосбиржи из ISS (SPEC-0003).",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Собирать ленту сделок рынка акций и FORTS из ISS."
        },
        "poll_interval_sec": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 60,
          "description": "Пауза между циклами догонки ленты, секунды."
        }
      }
    },
    "signals": {
      "type": "object",
      "description": "Сигналы по объёмам и их доставка роботу в Redis Stream (SPEC-0008).",
      "properties": {
        "enabled": {"type": "boolean", "default": false},
        "redis": {
          "type": "object",
          "description": "Redis робота; пароль — только переменная окружения CLUSTER_SOURCE_REDIS_PASSWORD.",
          "properties": {
            "host": {"type": "string", "default": "127.0.0.1"},
            "port": {"type": "integer", "default": 6379},
            "db": {"type": "integer", "minimum": 0, "default": 0},
            "stream": {"type": "string", "default": "cluster.events"},
            "retention_days": {"type": "integer", "minimum": 1, "default": 90}
          }
        },
        "verify_deadline_min": {"type": "number", "exclusiveMinimum": 0, "default": 20},
        "baseline_days": {"type": "integer", "minimum": 1, "default": 20},
        "baseline_min_days": {"type": "integer", "minimum": 1, "default": 5},
        "large_aggressor_percentile": {"type": "number", "exclusiveMinimum": 0, "maximum": 100, "default": 99.9},
        "volume_spike_ratio": {"type": "number", "exclusiveMinimum": 0, "default": 5},
        "volume_spike_percentile": {"type": "number", "exclusiveMinimum": 0, "maximum": 100, "default": 90},
        "regimes": {
          "type": "object",
          "description": "Режимы торгов по рынкам (shares, forts): {режим: [начало, конец]} МСК HH:MM.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "array", "items": {"type": "string", "pattern": "^\\d{2}:\\d{2}$"}, "minItems": 2, "maxItems": 2
            }
          }
        }
      }
    },
    "keep_awake": {
      "type": "boolean",
      "default": true,
      "description": "macOS: запрещать сон по простою, пока работает процесс (caffeinate -i -w PID), SPEC-0010."
    },
    "history_check_days": {
      "type": "integer",
      "minimum": 1,
      "default": 14,
      "description": "Окно в днях (включая сегодняшний) для догрузки отсутствующих и перекачки отмеченных дней."
    },
    "tickers": {
      "type": "array",
      "default": [],
      "description": "Инструменты для сбора.",
      "items": {
        "$ref": "#/$defs/instrument"
      }
    }
  },
  "$defs": {
    "instrument": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Тикер акции или фьючерсного контракта; для continuous_futures — код базового актива (с учётом регистра), контракты имеют вид {id}{код месяца}{год}.",
          "examples": [
            "SBER",
            "SiZ6",
            "Si"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "share",
            "futures_contract",
            "continuous_futures"
          ],
          "description": "Тип инструмента (InstrumentType)."
        },
        "tick_size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.01,
          "description": "Шаг цены для округления в footprint."
        },
        "lot_size": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Размер лота. Справочное поле (L-09)."
        }
      }
    }
  },
  "examples": [
    {
      "TOKEN": "t.xxxxxxxx",
      "data_dir": "data",
      "batch": {
        "flush_interval_sec": 5,
        "batch_size": 1000
      },
      "history_check_days": 14,
      "tickers": [
        {
          "id": "SBER",
          "type": "share",
          "tick_size": 0.01,
          "lot_size": 1
        },
        {
          "id": "Si",
          "type": "continuous_futures",
          "tick_size": 1.0,
          "lot_size": 1000
        }
      ],
      "archiver": {
        "run_hour_utc": 0,
        "run_minute_utc": 5
      }
    }
  ]
}
